{
  "name": "@moritzloewenstein/pdfkit",
  "type": "module",
  "description": "A PDF generation library",
  "keywords": [
    "pdf",
    "pdf writer",
    "pdf generator",
    "graphics",
    "document",
    "vector"
  ],
  "version": "0.100.177",
  "homepage": "http://pdfkit.org/",
  "author": {
    "name": "Devon Govett",
    "email": "devongovett@gmail.com",
    "url": "http://badassjs.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoritzLoewenstein/pdfkit.git"
  },
  "bugs": "https://github.com/MoritzLoewenstein/pdfkit/issues",
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.7",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "codemirror": "~6.0.2",
    "jest-diff": "^30.5.2",
    "jest-image-snapshot": "^6.5.2",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "pug": "^3.0.4",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "fontkit": "^3.0.0",
    "linebreak": "^2.0.0",
    "png-js": "^3.0.0",
    "uint8array-extras": "^1.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr lib/document.js",
    "build:watch": "vite build --watch --emptyOutDir false",
    "playground:build": "vite build --config vite.playground.config.js",
    "playground:preview": "vite preview --config vite.playground.config.js",
    "biome": "biome check",
    "biome:write": "biome check --write",
    "biome:ci": "biome ci",
    "pdf-guide": "node docs/generate.js",
    "website": "node docs/generate_website.js",
    "docs": "npm run pdf-guide && npm run website",
    "test": "vitest",
    "test:package": "node tests/package-resolution.mjs",
    "test:ui": "vitest --ui",
    "test:snapshot-update": "vitest -u",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": ["dist"],
  "module": "./dist/pdfkit.js",
  "exports": {
    ".": {
      "import": {
        "node": "./dist/pdfkit.node.js",
        "default": "./dist/pdfkit.js"
      }
    }
  },
  "imports": {
    "#zlib": {
      "node": "./lib/zlib/node.js",
      "default": "./lib/zlib/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "22.19.0"
  }
}
