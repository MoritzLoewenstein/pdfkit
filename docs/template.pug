doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= page.title
    link(rel='stylesheet', href='website.css')
    script(type='module', src='website.js')
  body
    nav.sidebar(aria-label='Documentation')
      ul
        each chapter in pages
          li
            a(href=chapter.url, aria-current=chapter === page ? 'page' : undefined)= chapter.title.replace(/ (with|in) PDFKit$/, '')
            if chapter === page && page.headers.length
              ul
                each header in page.headers
                  li
                    a(href='#' + header.id)= header.title
        li
          a(href='guide.pdf') PDF Guide
        li
          a(href='kitchen-sink.pdf') Example PDF
        li
          a(href='https://github.com/moritzloewenstein/pdfkit') Source Code
        li
          a(href='../playground/', target='_blank', rel='noopener') Playground
    main
      != page.content
      nav.pagination(aria-label='Chapter navigation')
        if index > 0
          a(href=pages[index - 1].url, rel='prev') Previous
        if index < pages.length - 1
          a(href=pages[index + 1].url, rel='next') Next
