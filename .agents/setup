#!/usr/bin/env bash
set -euo pipefail

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
if [[ ! -x "$VOLTA_HOME/bin/volta" ]]; then
  echo 'Installing Volta'
  time curl -fsSL https://get.volta.sh | bash -s -- --version 2.0.2 --skip-setup
fi
"$VOLTA_HOME/bin/volta" setup
export PATH="$VOLTA_HOME/bin:$PATH"

echo 'Activating the Node.js version pinned in package.json'
time node --version
npm --version

echo 'Installing dependencies from package-lock.json'
time npm ci --include=dev --no-audit --no-fund
